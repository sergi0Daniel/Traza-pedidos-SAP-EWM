# ------------------------------
# SAP EWM - completar SOLO con datos entregados y autorizados por TI
# ------------------------------
EWM_ENABLED=false
EWM_ORDERS_URL=
EWM_HEALTH_URL=
# Valores admitidos: none, bearer, basic. Confirmar con TI.
EWM_AUTH_TYPE=none
EWM_API_TOKEN=
EWM_USERNAME=
EWM_PASSWORD=
# Ruta al certificado CA corporativo si TI lo proporciona. Dejar vacío para validación TLS estándar.
EWM_CA_BUNDLE=
EWM_TIMEOUT_SECONDS=15

# ------------------------------
# Tiempos objetivo aprobados por Operaciones (minutos)
# Dejar vacíos hasta recibir los valores oficiales.
# ------------------------------
SLA_PICKING_MINUTES=
SLA_EMPAQUE_MINUTES=
SLA_STAGING_MINUTES=
SLA_LOADING_MINUTES=

# ------------------------------
# Inteligencia artificial - desactivada hasta autorización de Corona
# ------------------------------
AI_ENABLED=false
AI_DATA_APPROVED=false
OPENAI_API_KEY=
OPENAI_MODEL=
AI_TIMEOUT_SECONDS=45

# Aplicación
FLASK_DEBUG=false
PORT=5000
